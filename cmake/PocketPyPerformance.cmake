# Optional performance flags for an already-integrated TinyPy target.
# This file intentionally does not modify the repository root CMakeLists.txt.

set(PK_PGO_MODE "NONE" CACHE STRING "TinyPy PGO mode: NONE, GENERATE, or USE")
set_property(CACHE PK_PGO_MODE PROPERTY STRINGS NONE GENERATE USE)
set(PK_PGO_DIR "${CMAKE_BINARY_DIR}/pgo" CACHE PATH "Directory used for GCC/Clang PGO data")
set(PK_PGO_PROFILE "${PK_PGO_DIR}/tinypy.profdata" CACHE FILEPATH "Merged Clang PGO profile")

function(pk_apply_performance_flags target)
    if(NOT TARGET ${target})
        message(FATAL_ERROR "pk_apply_performance_flags: target '${target}' does not exist")
    endif()

    string(TOUPPER "${PK_PGO_MODE}" _pk_pgo_mode)
    if(NOT _pk_pgo_mode MATCHES "^(NONE|GENERATE|USE)$")
        message(FATAL_ERROR "PK_PGO_MODE must be NONE, GENERATE, or USE")
    endif()

    if(MSVC)
        target_compile_options(${target} PRIVATE /O2 /GL /Gy /Gw)
        target_link_options(${target} PRIVATE /LTCG)
        if(_pk_pgo_mode STREQUAL "GENERATE")
            target_link_options(${target} PRIVATE /GENPROFILE)
        elseif(_pk_pgo_mode STREQUAL "USE")
            target_link_options(${target} PRIVATE /USEPROFILE)
        endif()
        return()
    endif()

    if(CMAKE_C_COMPILER_ID MATCHES "Clang")
        target_compile_options(${target} PRIVATE -O3 -flto=thin)
        target_link_options(${target} PRIVATE -flto=thin)
        if(_pk_pgo_mode STREQUAL "GENERATE")
            target_compile_options(${target} PRIVATE "-fprofile-generate=${PK_PGO_DIR}")
            target_link_options(${target} PRIVATE "-fprofile-generate=${PK_PGO_DIR}")
        elseif(_pk_pgo_mode STREQUAL "USE")
            target_compile_options(${target} PRIVATE "-fprofile-use=${PK_PGO_PROFILE}" -Wno-profile-instr-unprofiled)
            target_link_options(${target} PRIVATE "-fprofile-use=${PK_PGO_PROFILE}")
        endif()
        return()
    endif()

    if(CMAKE_C_COMPILER_ID STREQUAL "GNU")
        target_compile_options(${target} PRIVATE -O3 -flto)
        target_link_options(${target} PRIVATE -flto)
        if(_pk_pgo_mode STREQUAL "GENERATE")
            target_compile_options(${target} PRIVATE "-fprofile-generate=${PK_PGO_DIR}")
            target_link_options(${target} PRIVATE "-fprofile-generate=${PK_PGO_DIR}")
        elseif(_pk_pgo_mode STREQUAL "USE")
            target_compile_options(${target} PRIVATE "-fprofile-use=${PK_PGO_DIR}" -fprofile-correction)
            target_link_options(${target} PRIVATE "-fprofile-use=${PK_PGO_DIR}" -fprofile-correction)
        endif()
        return()
    endif()

    message(WARNING "No TinyPy performance flag policy for compiler '${CMAKE_C_COMPILER_ID}'")
endfunction()
