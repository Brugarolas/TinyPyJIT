{
  "name": "clank-builder",
  "version": "0.1.0",
  "description": "A tiny custom builder make in TypeScript because I hate dealing with old CMake setups",
  "main": "build/tinypy.build.ts",
  "scripts": {
    "build:node": "node build/tinypy.build.ts",
    "build:bun": "bun build/tinypy.build.ts",
    "build:tinypy": "bun run build/tinypy.build.ts --release --compiler mingw",
    "build:tinypy:regvm": "bun run build/tinypy.build.ts --release --compiler mingw --interpreter regvm",
    "build:tinypy:stack": "bun run build/tinypy.build.ts --release --compiler mingw --interpreter stack",
    "doctor": "bun run build/tinypy.build.ts --doctor",
    "typecheck": "tsc --noEmit",
    "test": "tsc && node --test build/tests/*.test.js"
  },
  "dependencies": {
    "ts-node": "^10.9.2",
    "typescript": "^7.0.2"
  },
  "type": "module",
  "keywords": [ "build-system","custom-builder", "project-builder" ],
  "author": "Andrés Brugarolas",
  "license": "ISC"
}